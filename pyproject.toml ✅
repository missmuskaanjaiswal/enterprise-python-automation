
[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "enterprise-python-automation"
version = "1.0.0"
description = "Enterprise Python Automation and Reporting Tool"
requires-python = ">=3.9"
dependencies = [
    "requests",
    "APScheduler"
]

[project.scripts]
enterprise-automation = "enterprise_automation.cli:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
pythonpath = ["src"]
